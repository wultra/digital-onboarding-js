{
  "compilerOptions": {
    "target": "es5",
    "module": "es2015",
    "lib": ["es2015"],
    "strict": true,
    "declaration": false,
    "sourceMap": true,
    "removeComments": false, // Keep comments for better documentation
    "noImplicitAny": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
  }
}