# Copy this file to `.env` (gitignored) and fill in the values.
# Values are injected into the test app bundle at build time by `rollup.config.app.js`.

# Enrollment server URL, e.g. "https://powerauth-server-example.com/enrollment-server/"
WDO_ES_URL=""
# Enrollment server onboarding URL, e.g. "https://powerauth-server-example.com/enrollment-server-onboarding/"
WDO_ESO_URL=""
# Base64-encoded PowerAuth configuration
WDO_PA_CONFIG=""
# Base64-encoded Basic Auth credentials for the server API (just the part after "Basic ")
WDO_AUTHORIZATION=""

# BlinkID license keys. Leave empty to skip the real BlinkID document-scanning SDK and fall back to the mocked document upload.
WDO_BLINKID_LICENSE_IOS=""
WDO_BLINKID_LICENSE_ANDROID=""
